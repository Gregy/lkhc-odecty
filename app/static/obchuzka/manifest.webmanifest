{
  "name": "LKHC Odečty – obchůzka",
  "short_name": "LKHC Odečty",
  "description": "Odečty elektroměrů na letišti LKHC: foto, potvrzení stavu, offline fronta.",
  "lang": "cs",
  "id": "/obchuzka/",
  "start_url": "/obchuzka/",
  "scope": "/obchuzka/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f6f4",
  "theme_color": "#1f5fa8",
  "icons": [
    {"src": "/static/obchuzka/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "/static/obchuzka/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "/static/obchuzka/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "/obchuzka/sdilet",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{"name": "photos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp"]}]
    }
  }
}
