# /srv/lkhc-odecty/backup/backup.env - settings of backup.sh / restore.sh (not secret; mode 0640).
# Read by bash (sourced): quote values that contain spaces.
#   install -m 0640 -o deploy -g deploy backup.env.example /srv/lkhc-odecty/backup/backup.env

# rclone remote + folder. "gdrive" is the remote name from rclone.conf. With client-side encryption
# use the crypt remote instead, e.g. BACKUP_REMOTE=gdrive-crypt:
BACKUP_REMOTE=gdrive:lkhc-odecty-zalohy

# Retention of DB snapshots on the remote (photos are only ever added, never pruned).
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Snapshots kept inside the data volume (/data/backups/nightly).
LOCAL_KEEP=3

# `backup.sh check` fails when the last success is older than this.
MAX_AGE_HOURS=36

# Optional dead-man's switch, e.g. https://hc-ping.com/<uuid> (healthchecks.io, free): pinged on
# start/success/failure; it e-mails you on a failure or when no ping arrives in time.
HC_PING_URL=

# Pinned rclone image (no rclone install on the host).
RCLONE_IMAGE=rclone/rclone:1.76.0

# Name of the app's data volume (compose.yml: volumes.data.name).
DATA_VOLUME=lkhc-odecty-data
