# /srv/proxy/.env - installation-specific values for the proxy (not secret; keep it out of git).
# Let's Encrypt account e-mail (expiry warnings, problems with certificates).
ACME_EMAIL=admin@example.org
# Public host name of LKHC Odečty (DNS A/AAAA -> this VPS). Used by caddy/sites/lkhc-odecty.caddy.
LKHC_ODECTY_HOST=odecty.example.org
