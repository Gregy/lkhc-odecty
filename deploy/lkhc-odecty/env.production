# /srv/lkhc-odecty/.env - production configuration of LKHC Odečty. CONTAINS SECRETS.
#   install -m 0600 -o deploy -g deploy env.production /srv/lkhc-odecty/.env
# Never commit the filled-in file. All variables are explained in ../../.env.example.

APP_ENV=production
# public URL, no trailing slash (LKHC_ODECTY_HOST in /srv/proxy/.env must be the same host)
BASE_URL=https://odecty.example.org
TZ=Europe/Prague

# Generate once (changing it later logs everyone out):
#   head -c 48 /dev/urandom | base64 | tr -d '\n/+=' ; echo
SECRET_KEY=

# Google Workspace login: OAuth client "Web application" in the Workspace's Google Cloud project,
# authorized redirect URI <BASE_URL>/auth/callback. Empty = the app runs, /login explains it is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace domain allowed to log in, e.g. example.org
ALLOWED_DOMAIN=
# comma-separated e-mails that are always admins
ADMIN_EMAILS=
AUTH_DEV_BYPASS=0

# Reading meter values from photos via OpenRouter. Leave EXTRACTOR=none until the key is known;
# then set EXTRACTOR=openai_compat, fill in the key and run /srv/lkhc-odecty/deploy.sh --restart
EXTRACTOR=none
EXTRACTOR_BASE_URL=https://openrouter.ai/api/v1
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=google/gemini-2.5-flash
EXTRACTOR_TIMEOUT=120
EXTRACTOR_MAX_SIDE=1600
# 1 = read every photo twice; a value the second read does not repeat is marked doubtful in the review.
# Doubles the model cost per photo.
EXTRACTOR_VERIFY=0
