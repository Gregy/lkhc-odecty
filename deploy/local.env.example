# deploy/local.env - YOUR installation's values (git-ignored). Copy this file and fill it in; the
# scripts on your computer (push-image.sh) read it, and deploy/README.md refers to the variables.
#   cp deploy/local.env.example deploy/local.env
DEPLOY_HOST=deploy@203.0.113.10          # ssh target of the VPS (user deploy)
APP_HOST=odecty.example.org              # public host name (DNS A/AAAA -> VPS)
ALLOWED_DOMAIN=example.org               # Google Workspace domain allowed to log in
ADMIN_EMAILS=admin@example.org           # first admins (comma-separated)
ACME_EMAIL=admin@example.org             # Let's Encrypt account e-mail
