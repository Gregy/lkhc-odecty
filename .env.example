# LKHC Odečty – configuration (copy to .env and fill in). Never commit .env.
# In docker-compose.yml APP_ENV, DATA_DIR and TZ are already set for the container.

# --- application ---------------------------------------------------------------------------------
# production | development | test. With "production" (and also whenever BASE_URL is not localhost)
# the app refuses to start with the dev SECRET_KEY or with AUTH_DEV_BYPASS=1.
APP_ENV=production

# Random secret for signing the session cookie, at least 32 characters. Changing it logs everyone out.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Public URL of the app exactly as users open it (no trailing slash). Used for the Google OAuth
# redirect URI (BASE_URL + /auth/callback). https:// also turns on Secure cookies and HSTS.
BASE_URL=https://odecty.example.org

# Where the SQLite database (app.db), photos/ and backups/ live. In the container: /data (volume).
DATA_DIR=./data

# Installation-specific private data (original spreadsheet, import mapping, notes) for the tools
# (python -m app.importer, scripts/check_private_data.py); default ./private, never committed.
# LKHC_PRIVATE_DIR=./private

# Optional: a different database URL (default sqlite:///$DATA_DIR/app.db). Only SQLite is tested.
# DATABASE_URL=

# Time zone of all dates and times in the app (readings are stored as local midnight of the day).
TZ=Europe/Prague

# --- login: Google Workspace (OIDC) ----------------------------------------------------------------
# OAuth client of type "Web application" in Google Cloud Console (project of your Workspace organisation,
# consent screen "Internal"). Authorized redirect URI: <BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only accounts of this Workspace domain may log in (checked server-side: hd claim + email_verified).
# Required in production; empty = nobody can log in via Google.
ALLOWED_DOMAIN=example.org

# Comma-separated e-mails that are always admins (others from the domain start as "reader";
# admins can change roles in Správa → Uživatelé), e.g. ADMIN_EMAILS=jana.novakova@example.org
ADMIN_EMAILS=

# Local development only: logs every request in as a fictional admin. Refused in production
# and whenever BASE_URL is not localhost.
AUTH_DEV_BYPASS=0

# --- photo extraction (reading meter values from photos) ------------------------------------------
# none          = no automatic reading, values are typed in (default)
# openai_compat = any OpenAI-compatible /chat/completions endpoint with image input
#                 (OpenRouter, Ollama, llama.cpp server, vLLM, ...)
# fake          = deterministic fake for tests/demos (reads nothing)
EXTRACTOR=none

# OpenRouter example:
#   EXTRACTOR_BASE_URL=https://openrouter.ai/api/v1
#   EXTRACTOR_API_KEY=sk-or-...
#   EXTRACTOR_MODEL=google/gemini-2.5-flash
# Local Ollama on the Docker host (uncomment extra_hosts in docker-compose.yml):
#   EXTRACTOR_BASE_URL=http://host.docker.internal:11434/v1
#   EXTRACTOR_API_KEY=
#   EXTRACTOR_MODEL=qwen2.5vl:7b
# llama.cpp server (llama-server -m model.gguf --mmproj mmproj.gguf --port 8080):
#   EXTRACTOR_BASE_URL=http://host.docker.internal:8080/v1
EXTRACTOR_BASE_URL=
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=

# Request timeout in seconds (small vision models on CPU are slow) and the longer image side (px)
# sent to the model. Only a downscaled JPEG without EXIF/GPS is sent.
EXTRACTOR_TIMEOUT=120
EXTRACTOR_MAX_SIDE=1600

# Second read: every photo with readable digits is sent to the model once more (an independent request with
# the same image and prompt). A value the second read does not reproduce is flagged as doubtful ("model si
# není jistý") and needs an explicit acknowledgement in the review; both reads are kept in the photo's
# extraction result. Catches confident misreads, but DOUBLES the model cost (and time) per photo.
EXTRACTOR_VERIFY=0

# --- container / proxy (docker-compose.yml) ---------------------------------------------------------
# Which client addresses may set X-Forwarded-Proto/-For (the reverse proxy). Set in docker-compose.yml.
# FORWARDED_ALLOW_IPS=*
# Skip `python -m app.migrate` in the entrypoint (not recommended).
# SKIP_MIGRATIONS=0
